# ==========================================
# Application
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# PostgreSQL (Render or Neon free tier)
# ==========================================
DATABASE_URL=postgresql://user:password@host:5432/dbname
# OR individual fields (if not using DATABASE_URL):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=edulearn_db
DB_SSL=true

# ==========================================
# JWT & Session
# ==========================================
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_long_random_string

# ==========================================
# CORS — set to your Vercel frontend URL in production
# ==========================================
CORS_ORIGIN=https://e-learning-three-phi.vercel.app

# ==========================================
# Google OAuth (optional)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://e-leraning.onrender.com/api/auth/google/callback

# ==========================================
# Payment (Chapa ETB / Birr Gateway)
# ==========================================
PAYMENT_GATEWAY_MODE=chapa
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret

# ==========================================
# SMTP Email Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="EduLearn Platform <no-reply@edulearn.com>"
ADMIN_CONTACT_EMAIL=admin@edulearn.com
